<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="crm.List.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <t t-if="this.env.searchModel.context.show_lead_gen_button">
                <LeadGenerationDropdown onCreate="() => this.createRecord()"/>
            </t>
            <CrmOfflinePrefetch
                getDomain="() => this.model.root.domain"
                getContext="() => this.props.context"/>
        </xpath>
    </t>
</templates>
