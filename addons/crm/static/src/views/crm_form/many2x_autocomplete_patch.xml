<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- lead form, small screen, offline: the autocomplete instead of the search dialog -->
    <t t-inherit="web.Many2XAutocomplete" t-inherit-mode="extension">
        <xpath expr="//input[@t-on-click='this.onSearchMore']" position="attributes">
            <attribute name="t-if">this.uiService.isSmall and this.props.dropdown and !this.crmSearchesCacheOffline</attribute>
        </xpath>
    </t>

</templates>
